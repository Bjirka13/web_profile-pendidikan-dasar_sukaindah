n,className:Te("inline-flex items-center gap-1.5",e),...t}));MP.displayName="BreadcrumbItem";const OQ=j.forwardRef(({asChild:e,className:t,...n},r)=>{const a=e?Mz:"a";return c.jsx(a,{ref:r,className:Te("transition-colors hover:text-foreground",t),...n})});OQ.displayName="BreadcrumbLink";const IQ=j.forwardRef(({className:e,...t},n)=>c.jsx("span",{ref:n,role:"link","aria-disabled":"true","aria-current":"page",className:Te("font-normal text-foreground",e),...t}));IQ.displayName="BreadcrumbPage";const MQ=({children:e,className:t,...n})=>c.jsx("li",{role:"presentation","aria-hidden":"true",className:Te("[&>svg]:size-3.5",t),...n,children:e??c.jsx(Cw,{})});MQ.displayName="BreadcrumbSeparator";const Ij=["Semua","Umum","Instalasi dan Akses","Guru dan Tenaga Kependidikan","Peserta Didik","Kurikulum dan Rombongan Belajar","Troubleshooting","Kontak dan Dukungan"],dh=[{id:"umum-1",category:"Umum",question:"Apa itu Aplikasi Dapodik?",answer:"Dapodik (Data Pokok Pendidikan) adalah sistem pendataan skala nasional yang dikelola oleh Kementerian Pendidikan Dasar dan Menengah untuk menghimpun data satuan pendidikan, peserta didik, pendidik, tenaga kependidikan, serta sarana dan prasarana sekolah.",details:["Data Dapodik menjadi rujukan utama untuk penyaluran berbagai program seperti BOS, PIP, tunjangan guru, dan kebijakan pendidikan lainnya.","Dapodik wajib diperbarui setiap semester oleh operator sekolah melalui aplikasi resmi."],source:"https://helpdesk.pauddasmen.id/help/en-us/56-umum"},{id:"umum-2",category:"Umum",question:"Kapan periode pengisian dan sinkronisasi Dapodik dilakukan?",answer:"Pengisian Dapodik dilakukan setiap semester, yaitu Semester Ganjil (Juli–Desember) dan Semester Genap (Januari–Juni). Tanggal cut-off ditetapkan oleh Direktorat Jenderal terkait."},{id:"instalasi-1",category:"Instalasi dan Akses",question:"Bagaimana cara mengunduh dan menginstal Aplikasi Dapodik versi terbaru?",answer:"Aplikasi Dapodik dapat diunduh melalui laman resmi dapo.dikdasmen.go.id pada menu Unduhan. Pastikan Anda mengunduh installer dan prefill data sesuai dengan jenjang sekolah.",details:["Tutup semua aplikasi Dapodik versi sebelumnya sebelum instalasi.","Jalankan installer sebagai Administrator (klik kanan → Run as Administrator).","Setelah instalasi selesai, lakukan registrasi menggunakan kode registrasi dan akun operator sekolah."],source:"https://helpdesk.pauddasmen.id/help/en-us/53-instalasi-dan-akses"},{id:"instalasi-2",category:"Instalasi dan Akses",question:"Apa persyaratan minimum perangkat untuk menjalankan Dapodik?",answer:"Spesifikasi minimum yang direkomendasikan: Processor dual-core, RAM 4 GB, ruang penyimpanan 5 GB, sistem operasi Windows 10/11, dan browser modern (Chrome/Edge/Firefox versi terbaru)."},{id:"instalasi-3",category:"Instalasi dan Akses",question:"Saya lupa kata sandi akun operator, bagaimana cara meresetnya?",answer:"Reset kata sandi dapat dilakukan melalui SDM PDM (sdm.pauddasmen.kemdikbud.go.id) menggunakan akun operator yang terdaftar, atau dengan menghubungi operator dinas pendidikan setempat."},{id:"gtk-1",category:"Guru dan Tenaga Kependidikan",question:"Bagaimana cara menambahkan data Guru atau Tenaga Kependidikan baru?",answer:"Penambahan PTK baru dilakukan oleh operator dinas pendidikan kabupaten/kota melalui aplikasi Manajemen Dinas. Operator sekolah hanya dapat menarik (tarik PTK) data PTK yang sudah terdaftar di sistem pusat.",details:["Pastikan PTK memiliki NIK yang valid dan belum terdaftar di sekolah lain.","Setelah PTK muncul, lengkapi rincian data kepegawaian, riwayat pendidikan, dan penugasan."],source:"https://helpdesk.pauddasmen.id/help/en-us/55-guru-dan-tenaga-kependidikan"},{id:"gtk-2",category:"Guru dan Tenaga Kependidikan",question:"Mengapa data PTK tidak muncul di Info GTK setelah sinkronisasi?",answer:"Pastikan data PTK valid (tidak ada warning di menu Validasi), penugasan aktif di tahun ajaran berjalan, jam mengajar terisi, dan sinkronisasi terakhir berhasil. Update Info GTK biasanya membutuhkan 1–7 hari setelah sinkron."},{id:"pd-1",category:"Peserta Didik",question:"Bagaimana cara menambahkan peserta didik baru ke Dapodik?",answer:"Peserta didik baru ditambahkan melalui menu Peserta Didik → Tambah, dengan terlebih dahulu mencari NISN/NIK siswa. Jika belum terdaftar, lakukan input data lengkap sesuai dokumen identitas resmi.",source:"https://helpdesk.pauddasmen.id/help/en-us/58-peserta-didik"},{id:"pd-2",category:"Peserta Didik",question:"Bagaimana cara memindahkan peserta didik (mutasi) antar sekolah?",answer:"Sekolah lama melakukan registrasi keluar pada peserta didik dengan alasan mutasi. Selanjutnya sekolah baru menarik peserta didik tersebut melalui menu Tarik PD setelah sinkronisasi sekolah lama."},{id:"kurikulum-1",category:"Kurikulum dan Rombongan Belajar",question:"Bagaimana cara membuat Rombongan Belajar (Rombel) baru?",answer:"Buka menu Rombongan Belajar → Tambah, pilih jenis rombel (kelas reguler, ekstrakurikuler, atau matpel pilihan), tentukan tingkat, kurikulum, wali kelas, lalu daftarkan anggota rombel dan pembelajaran.",source:"https://helpdesk.pauddasmen.id/help/en-us/59-kurikulum-dan-rombongan-belajar"},{id:"kurikulum-2",category:"Kurikulum dan Rombongan Belajar",question:"Bagaimana implementasi Kurikulum Merdeka di Dapodik?",answer:"Sekolah pelaksana Kurikulum Merdeka memilih kurikulum yang sesuai (Mandiri Belajar/Berubah/Berbagi) saat membuat rombel. Struktur mata pelajaran dan pembelajaran akan otomatis menyesuaikan template kurikulum yang dipilih."},{id:"trouble-1",category:"Troubleshooting",question:"Aplikasi Dapodik gagal sinkronisasi, apa yang harus dilakukan?",answer:"Periksa koneksi internet, jalankan validasi lokal terlebih dahulu, perbaiki seluruh data invalid, lalu coba sinkronisasi ulang. Jika tetap gagal, restart service Dapodik atau lakukan generate prefill ulang.",details:["Pastikan firewall/antivirus tidak memblokir aplikasi Dapodik.","Coba pada jam non-puncak (di luar jam 09.00–15.00 WIB) untuk menghindari antrian server."],source:"https://helpdesk.pauddasmen.id/help/en-us/57-troubleshooting"},{id:"trouble-2",category:"Troubleshooting",question:"Muncul pesan 'Database tidak ditemukan' saat membuka Dapodik. Solusinya?",answer:"Lakukan stop & start service DapodikDB melalui Services Windows, atau jalankan ulang installer Dapodik dengan opsi Repair. Pastikan port 5774 tidak digunakan aplikasi lain."},{id:"kontak-1",category:"Kontak dan Dukungan",question:"Kemana saya dapat menghubungi tim helpdesk Dapodik?",answer:"Anda dapat menghubungi helpdesk resmi melalui laman helpdesk.pauddasmen.id, email helpdesk dapodik resmi, atau berkoordinasi dengan operator dinas pendidikan kabupaten/kota Anda.",source:"https://helpdesk.pauddasmen.id/help/en-us/60-kontak-dan-dukungan"}];function Mj(e,t){if(!t.trim())return e;const n=t.replace(/[.*+?^${}()|[\]\\]/g,"\\$&");return e.split(new RegExp(`(${n})`,"gi")).map((a,i)=>a.toLowerCase()===t.toLowerCase()?c.jsx("mark",{className:"rounded bg-secondary/30 px-0.5 text-foreground",children:a},i):c.jsx("span",{children:a},i))}const GVe=()=>{const[e,t]=j.useState("Semua"),[n,r]=j.useState(""),a=j.useMemo(()=>{const o=n.trim().toLowerCase();return dh.filter(s=>e==="Semua"||s.category===e?o?s.question.toLowerCase().includes(o)||s.answer.toLowerCase().includes(o)||s.category.toLowerCase().includes(o)||(s.details??[]).some(u=>u.toLowerCase().includes(o)):!0:!1)},[e,n]),i=j.useMemo(()=>{const o={Semua:dh.length};for(const s of Ij)s!=="Semua"&&(o[s]=dh.filter(l=>l.category===s).length);return o},[]);return dh.length,Ij.length-1,dh.filter(o=>o.details&&o.details.length>0).length,c.jsxs("div",{className:"min-h-screen bg-background",children:[c.jsxs(am,{children:[c.jsx("title",{children:"FAQ — Pusat Bantuan Dapodik"}),c.jsx("meta",{name:"description",content:"Pusat bantuan Dapodik: jawaban seputar instalasi, akun, peserta didik, GTK, sinkronisasi, validasi, dan panduan penggunaan."}),c.jsx("link",{rel:"canonical",href:"/faq"})]}),c.jsx(Nr,{}),c.jsxs("section",