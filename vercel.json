{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "pnpm install --force && node ./node_modules/vite/bin/vite.js build",
      "devCommand": "node ./node_modules/vite/bin/vite.js --port 3000 --strictPort",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend/",
      "buildCommand": "npm install --force --ignore-scripts && npm run build",
      "devCommand": "npm run dev",
      "entrypoint": "dist/server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/sitemap.xml",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
